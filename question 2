public class BankAccount {
    
    private String accountNumber;
    private String customerName;
    private double balance;
    
    public BankAccount(String accountNumber, String customerName, double balance) {
        this.accountNumber = accountNumber;
        this.customerName = customerName;

        if (balance >= 0) {
            this.balance = balance;
        } else {
            this.balance = 0;
        }
    }
    
    public double getBalance() {
        return balance;
    }
    
    public void deposit(double amount) {
        if (amount > 0) {
            balance += amount;
            System.out.println("Deposit successful: $" + amount);
        } else {
            System.out.println("Invalid deposit amount.");
        }
    }
    
    public void withdraw(double amount) {
        if (amount > 0 && amount <= balance) {
            balance -= amount;
            System.out.println("Withdrawal successful: $" + amount);
        } else {
            System.out.println("Invalid withdrawal or insufficient balance.");
        }
    }
    
    public void displayAccount() {
        System.out.println("----------------------------");
        System.out.println("Account Number: " + accountNumber);
        System.out.println("Customer Name: " + customerName);
        System.out.println("Balance: $" + balance);
    }

    public static void main(String[] args) {
        
        BankAccount ahmed =
                new BankAccount("ACC001", "Ahmed", 1000);
        
        BankAccount mohamed =
                new BankAccount("ACC002", "Mohamed", 1500);


  

        ahmed.displayAccount();

        ahmed.deposit(500);
        ahmed.withdraw(200);

        System.out.println("Ahmed Current Balance: $" +
                ahmed.getBalance());



        mohamed.displayAccount();

        mohamed.deposit(300);
        mohamed.withdraw(400);

        System.out.println("Mohamed Current Balance: $" +
                mohamed.getBalance());
    }
}